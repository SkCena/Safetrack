<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#121212">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="CyberSkOD Free"
        android:textColor="#00E676"
        android:textSize="32sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SafeTrack"
        android:textColor="#FFFFFF"
        android:textSize="20sp"
        android:layout_marginBottom="32dp" />

    <Button
        android:id="@+id/btnLocationPerm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Grant Location Permission"
        android:backgroundTint="#333333"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnUsagePerm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Grant App Usage Permission"
        android:backgroundTint="#333333"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="8dp" />

    <Button
        android:id="@+id/btnBatteryPerm"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Disable Battery Restrictions"
        android:backgroundTint="#333333"
        android:textColor="#FFFFFF"
        android:layout_marginBottom="24dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Setup Pending"
        android:textColor="#B0BEC5"
        android:textSize="16sp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnHideApp"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Hide Application"
        android:backgroundTint="#FF5252"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnActivateAdmin"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Activate Admin"
        android:backgroundTint="#333333"
        android:textColor="#FFFFFF" />

    <Button
        android:id="@+id/btnOpenDashboard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Open Dashboard"
        android:backgroundTint="#00E676"
        android:textColor="#000000"
        android:visibility="gone" />

    <Button
        android:id="@+id/btnForceTrack"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Force Track Now (Test)"
        android:backgroundTint="#FFA726"
        android:textColor="#000000"
        android:layout_marginTop="8dp" />

</LinearLayout>
