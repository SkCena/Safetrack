<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="@dimen/space_lg"
    android:gravity="center_horizontal"
    android:background="@color/bg_root">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Welcome"
        android:textColor="@color/text_tertiary"
        android:textSize="@dimen/text_caption"
        android:letterSpacing="0.15"
        android:textStyle="bold"
        android:layout_marginTop="@dimen/space_xl" />

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="SafeTrack"
        android:textColor="@color/brand_primary"
        android:textSize="@dimen/text_display"
        android:textStyle="bold"
        android:layout_marginTop="@dimen/space_sm" />

    <TextView
        android:id="@+id/tvDescription"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textSize="@dimen/text_subtitle"
        android:textColor="@color/text_secondary"
        android:gravity="center"
        android:layout_marginTop="@dimen/space_lg"
        android:layout_marginBottom="@dimen/space_xl" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnGrantPermissions"
        style="@style/Widget.SafeTrack.Button.Primary"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>
